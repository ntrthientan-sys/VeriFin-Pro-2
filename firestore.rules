rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ntrthientan@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /users/{uid}/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /workspaces/{workspaceId}/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /inventory/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /orders/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /invoices/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /creditApplications/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /evidence/{document=**} { allow read, write: if isAuthorizedAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}

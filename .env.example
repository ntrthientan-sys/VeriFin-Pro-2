# Copy to .env. Never commit real secrets.
PORT=3000
DATA_DIR=./data
ADMIN_EMAILS=
ADMIN_PASSWORD=
GEMINI_MODEL=gemini-2.5-flash
# Optional Firebase browser client configuration; never used for Gemini.
VITE_FIREBASE_API_KEY=
# Must match the client Firebase project's ID to enable server token verification.
FIREBASE_PROJECT_ID=
# Default reserved admin identity: ntrthientan@gmail.com. Set ADMIN_PASSWORD only on the server.
# Firebase Admin SDK requires Application Default Credentials or a service-account path.
GOOGLE_APPLICATION_CREDENTIALS=
# Use the same named database as the browser client; defaults to firebase-applet-config.json.
FIREBASE_DATABASE_ID=
FIREBASE_WEB_API_KEY=
# Optional client overrides. Firebase web config is distinct from Gemini BYOK.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=

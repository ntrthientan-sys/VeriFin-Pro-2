# Copy to .env. Never commit real secrets.
PORT=3000
DATA_DIR=./data
ADMIN_EMAILS=
ADMIN_PASSWORD=
GEMINI_MODEL=gemini-2.5-flash
# Optional Firebase browser client configuration; never used for Gemini.
VITE_FIREBASE_API_KEY=
# Must match the client Firebase project's ID to enable server token verification.
FIREBASE_PROJECT_ID=
